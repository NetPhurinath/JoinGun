# Copy to .env and fill in. .env is ignored by Git; never commit real keys.

# Long random string (at least 32 characters). Keys for email hashing/encryption and codes are derived from it.
# Changing it later makes existing accounts unreachable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Gmail used to send sign-in codes (no domain needed). Use a Gmail account made for the project.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords (16 letters; spaces are fine)
# Personal Gmail sends to about 500 recipients per 24 hours. Without both values, codes print to the console.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=JoinGun

# Accepted sign-up email domains: anything ending in this suffix (default ac.th = Thai educational institutions).
ALLOWED_EMAIL_SUFFIX=ac.th

# Local defaults. For hosting: NODE_ENV=production, HOST=0.0.0.0, TRUST_PROXY=true behind the platform's proxy.
# NODE_ENV=production requires APP_SECRET, DATABASE_URL, GMAIL_USER and GMAIL_APP_PASSWORD, and makes the session
# cookie Secure (HTTPS only). Render sets PORT itself.
PORT=3000
HOST=127.0.0.1
# NODE_ENV=production
# TRUST_PROXY=true
# COOKIE_SECURE=true

# PostgreSQL. On Render, render.yaml sets this to the database's internal URL (a host name with no dot, on
# Render's private network; no TLS needed). For any other host TLS is turned on
# automatically; set DATABASE_SSL=false to turn it off or DATABASE_SSL=true to force it.
# Leave DATABASE_URL empty in development: the server then uses a local PGlite database in data/pglite/.
DATABASE_URL=
# DATABASE_SSL=

# Moderators: comma-separated emails that get the report review screen when they sign in.
# Or promote an existing account: npm run moderator -- <username>
MODERATOR_EMAILS=
